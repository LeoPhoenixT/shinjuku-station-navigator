{
  "name": "shinjuku-indoor-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "docker:build": "docker build --tag shinjuku-indoor-navigator:local .",
    "container:verify": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/verify-container.js",
    "data:inspect": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/inspect-dataset.js",
    "data:profile": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/profile-map-semantics.js",
    "data:network": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/import-official-network.js",
    "data:network:validate": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/validate-official-network.js",
    "data:network:reviewed": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-reviewed-custom-network.js",
    "data:places": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-named-places.js",
    "data:translations": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-place-translations.js",
    "data:markers": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-facility-marker-report.js",
    "data:map": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-full-map.js",
    "data:golden-route": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-human-golden-route.js",
    "data:convert": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/convert-dataset.js",
    "data:validate": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/validate-data.js",
    "data:build": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/build-all-data.js",
    "data:check": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/check-generated-data.js",
    "release:verify": "npm run build && tsc -p tsconfig.scripts.json && node dist-scripts/scripts/verify-deployment.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.0.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
